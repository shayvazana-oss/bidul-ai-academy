# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Values with special characters ({, [, *, etc.) MUST be single-quoted.

# ── Arcads (skill: .claude/skills/arcads-external-api) ───────────────────────
# Option A (recommended) — pre-encoded Basic auth header from
# https://app.arcads.ai/settings/api . Looks like: Basic ODQxMTg4NDEx...
ARCADS_BASIC_AUTH='Basic your_base64_encoded_credentials_here'

# Option B — API key only (used as HTTP Basic username, empty password).
# Some accounts get 403 with this method; if so use Option A.
# ARCADS_API_KEY=your_key_here

# Optional
# ARCADS_BASE_URL=https://external-api.arcads.ai
